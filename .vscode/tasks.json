{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "シフト最適化を起動",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"streamlit",
				"run",
				"${workspaceFolder}/src/app.py",
				"--server.address",
				"127.0.0.1",
				"--server.port",
				"8501",
				"--browser.gatherUsageStats",
				"false"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": []
		}
	]
}